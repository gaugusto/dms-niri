
alias fzf='fzf --height 80% --layout reverse --border'
alias pac-info="pacman -Qq | fzf --preview 'pacman -Qi {}'"
alias pac-install="pacman -Sl | awk '{print \$2}' | fzf -m --preview 'pacman -Si {}' --layout=reverse | xargs -ro sudo pacman --needed -S"
alias pac-uninstall="pacman -Qq | fzf -m --preview 'pacman -Si {}' --layout=reverse | xargs -ro sudo pacman -Rsc"
