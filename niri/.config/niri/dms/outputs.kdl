
output "DP-1" {
    // off
    mode "3440x1440@180.000"
    scale 1.0
    position x=0 y=0
    variable-refresh-rate on-demand=true
    focus-at-startup

    hot-corners {
        off
    }
}


output "DP-2" {
    // off
    mode "3440x1440@100"
    scale 1.0
    position x=1440 y=0
    // variable-refresh-rate on-demand=true

    hot-corners {
        off
    }
}

