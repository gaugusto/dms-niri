// Include dms files
include "dms/colors.kdl"
include "dms/layout.kdl"
include "dms/alttab.kdl"
include "dms/binds.kdl"
include "dms/outputs.kdl"
include "dms/cursor.kdl"

screenshot-path "~/Imagens/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"

hotkey-overlay {
    skip-at-startup
}

input {
  keyboard {
    xkb {
      layout "br"
    }
    repeat-delay 200
    repeat-rate 35
    numlock
  }
  touchpad {
    tap
  }
  // warp-mouse-to-focus
  focus-follows-mouse max-scroll-amount="0%"
}

overview {
    zoom 0.5
    backdrop-color "#1a1b26"

    workspace-shadow {
        // off
        softness 40
        spread 10
        offset x=0 y=10
        color "#00000050"
    }
}

workspace "󰖟" {
  open-on-output "DP-3"
}
workspace "" {
  open-on-output "DP-3"
}
workspace "" {
  open-on-output "DP-2"
}
workspace "󰺷" {
  open-on-output "DP-2"
}

window-rule {
    match app-id="firefox"
    match app-id="chromium"
    open-on-workspace "󰖟"
    open-maximized true
}

window-rule {
    match app-id="Alacritty"
    open-on-workspace ""
}

window-rule {
    match app-id="mpv"
    open-on-workspace ""
    open-maximized true
}

window-rule {
  match app-id="gamescope"
  open-on-workspace "󰺷"
  open-fullscreen true
}

window-rule {
  match app-id=r#"steam$"#
  open-on-workspace "󰺷"
  open-floating true
}

window-rule {
  match app-id=r#"org.quickshell$"#
  match app-id="org.gnome.Calculator"
  match app-id="org.gnome.Nautilus"
  match app-id="nwg-look"
  match app-id="Pinentry-gtk"
  match app-id="qemu"
  match app-id="mpv"
  open-floating true
}

window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
}

binds {

  Mod+B hotkey-overlay-title="Open a Browser: firefox" {
    spawn "firefox";
  }

  Mod+E hotkey-overlay-title="Nautilus" {
    spawn "nautilus";
  }

  Mod+Alt+D hotkey-overlay-title="Open D-Menu" {
    spawn-sh "~/.local/bin/dmenus";
  }

  Mod+Alt+Y hotkey-overlay-title="Youtube" {
    spawn-sh ".local/bin/youtube.sh";
  }

  Mod+Alt+P hotkey-overlay-title="Passwords" {
    spawn-sh ".local/bin/pass.sh";
  }

  Mod+Alt+C hotkey-overlay-title="Clear cliphist" {
    spawn "cliphist" "wipe" ;
  }

}
